<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>TorrServerManager</AssemblyName>
    <RootNamespace>TorrServerManager</RootNamespace>
    <Version>1.23.0</Version>
    <Authors>Local TorrServer Manager</Authors>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishTrimmed>false</PublishTrimmed>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <!-- node_modules/ (npm's, for the plugin-bundling toolchain below) is never .NET project
         content — exclude it from every default item glob the SDK would otherwise scan it with,
         the same way it already excludes bin/obj. -->
    <DefaultItemExcludes>$(DefaultItemExcludes);node_modules/**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <_TorrentModPluginSource Include="Plugins/TorrentModPlugin/**/*.js" />
  </ItemGroup>

  <!-- Plugins/TorrentModPlugin/ is real ES module source (import/export) for the embedded Lampa
       plugin — see package.json. esbuild bundles it into the single classic script Lampa actually
       loads (Lampa injects one <script> tag per plugin; the target device is an LG WebOS TV
       browser, not worth the <script type="module"> risk). Requires Node.js — see README.md. -->
  <Target Name="EnsureNpmPackages" BeforeTargets="BuildTorrentModPluginBundle" Condition="!Exists('node_modules')">
    <Exec Command="npm install" />
  </Target>

  <Target Name="BuildTorrentModPluginBundle"
          BeforeTargets="BeforeBuild;CoreCompile"
          Inputs="package.json;@(_TorrentModPluginSource)"
          Outputs="Plugins/TorrentModPlugin.bundle.js">
    <Exec Command="npm run build:plugin" />
  </Target>

  <ItemGroup>
    <EmbeddedResource Include="Plugins/TorrentModPlugin.bundle.js" LogicalName="TorrServerManager.TorrentModPlugin.js" />
  </ItemGroup>
</Project>
